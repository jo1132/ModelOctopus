{
  "$defs": {
    "ProjectSpec": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "root": {
          "title": "Root",
          "type": "string"
        }
      },
      "required": [
        "name",
        "root"
      ],
      "title": "ProjectSpec",
      "type": "object"
    },
    "Step": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "id": {
          "pattern": "^[A-Za-z][A-Za-z0-9_-]*$",
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "title": "Kind",
          "type": "string"
        },
        "inputs": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Inputs",
          "type": "object"
        },
        "params": {
          "additionalProperties": true,
          "title": "Params",
          "type": "object"
        },
        "profile": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Profile"
        }
      },
      "required": [
        "id",
        "kind"
      ],
      "title": "Step",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "project": {
      "$ref": "#/$defs/ProjectSpec"
    },
    "environment_profiles": {
      "additionalProperties": {
        "type": "string"
      },
      "title": "Environment Profiles",
      "type": "object"
    },
    "steps": {
      "items": {
        "$ref": "#/$defs/Step"
      },
      "minItems": 1,
      "title": "Steps",
      "type": "array"
    }
  },
  "required": [
    "schema_version",
    "project",
    "steps"
  ],
  "title": "Recipe",
  "type": "object"
}
